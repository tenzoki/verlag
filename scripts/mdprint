#!/bin/bash
# Dependencies:
# npm install -g @mermaid-js/mermaid-cli
# brew install --cask basictex
# sudo tlmgr install collection-fontsrecommended
# sudo tlmgr install xurl       (fehlt in BasicTeX; ohne es werden lange Links nicht umbrochen und ragen über den Rand)
# brew install librsvg          (nur für --epub: wandelt SVG-Abbildungen in PNG)
# brew install epubcheck        (optional: prüft das EPUB nach dem Erzeugen)
#
# Aufruf und Optionen: mdprint --help

set -u

usage() {
  cat <<EOF
mdprint – erzeugt aus Markdown ein PDF (xelatex) oder ein EPUB für Kindle Direct Publishing.

AUFRUF
  mdprint [OPTIONEN] [NAME ...]

ARGUMENTE
  NAME            Markdown-Datei. Existiert NAME nicht, wird NAME.md versucht.
                  Ohne NAME: alle *.md im aktuellen Verzeichnis.
                  Die Ausgabe landet neben der Quelle: foo.md -> foo.pdf bzw. foo.epub.
                  Existiert sie bereits, fragt mdprint: [y]es / [n]o / [a]lle / [q]uit.

AUSGABEFORMAT
  --pdf           PDF erzeugen.                            Standard: ja, wenn --epub fehlt
  --epub          EPUB 3 für KDP erzeugen.                 Standard: nein
                  --epub allein erzeugt nur das EPUB; --epub --pdf erzeugt beides.

INHALTSVERZEICHNIS (PDF und EPUB)
  --no-toc        kein Inhaltsverzeichnis.                 Standard: mit Inhaltsverzeichnis
  --toc-depth=N   Tiefe 1-6.                               Standard: $TOC_DEPTH
  --toc-title=T   Überschrift des Verzeichnisses.          Standard: "Inhalt" (de), sonst "Contents"

PDF
  --footer=T      Fußzeile links auf jeder Seite.
                  Standard: "$FOOTER"
                  (eigener Standard: eine Zeile in $FOOTER_FILE, \$YEAR = Jahr)
  --no-footer     keine Fußzeile, nur Seitenzahl.
                  Titel = Dateiname. Autor, Untertitel, Datum aus dem YAML-Block der Datei
                  (author:, subtitle:, date:). DIN A4, Schrift DejaVu, 11pt, Rand 2,5 cm, Sprache aus --lang.
                  Tabellen: Spaltenbreiten nach Inhalt, linksbündig, kleinere Schrift
                  (Filter mdprint-tables.lua neben dem Skript).
  --trim=BxH      Buchformat in Zoll für den Druck, z. B.   Standard: aus (DIN A4, Rand 2,5 cm)
                  --trim=6x9 (Amazon KDP Taschenbuch). Setzt Seitengröße, doppelseitigen
                  Satz mit Bundsteg (innen 0,75 in, außen 0,55 in), Seitenzahl außen.
                  Ausgabe: foo-6x9.pdf; das normale foo.pdf bleibt unberührt.
                  Meldet danach Seitenzahl und Rückenbreite für den Umschlag.

EPUB
  --author=T      Autor; überschreibt author: aus der Datei. Standard: author: aus der Datei
  --cover=FILE    Titelbild einbetten (JPEG/PNG).          Standard: kein Cover
                  KDP nimmt das Cover beim Hochladen separat an; dann weglassen, sonst doppelt.
  --split-level=N Ab Überschriftenebene N (1-6) beginnt     Standard: oberste Ebene im Text
                  eine neue Datei, im Reader eine neue Seite. Sinnvoll: Ebene der Kapitel.
                  Titel = Dateiname; Autor, Untertitel, Datum aus dem YAML-Block (author:,
                  subtitle:, date:); Sprache aus --lang. SVG-Bilder werden zu PNG (rsvg-convert,
                  1600 px breit, weißer Hintergrund), Mermaid-Diagramme zu PNG. Ein Block
                  "include-before: |" im YAML-Kopf wird als Vorwort vor den Text gestellt.
                  Liegt epubcheck vor, wird das EPUB danach geprüft.

ALLGEMEIN
  <!-- pagebreak -->  auf eigener Zeile erzwingt einen Seitenumbruch (PDF und EPUB).
  --              Ende der Optionen; danach nur noch Dateinamen.
  --lang=L        Sprache des Manuskripts (de, en, ...).    Standard: de
                  Steuert Silbentrennung, Titel des Verzeichnisses und EPUB-Metadaten.
  --title=T       Titel; überschreibt den Dateinamen.        Standard: Dateiname ohne .md
  --outdir=DIR    Ausgabe in DIR statt neben die Quelle.     Standard: Ordner der Quelle
  -y, --yes       vorhandene Ausgaben ohne Rückfrage ersetzen (für automatische Läufe).
  -h, --help      diese Hilfe.

DATEIEN
  LaTeX-Präambel (PDF):  $LATEX_HEADER
  Stylesheet (EPUB):     $EPUB_CSS
  Tabellenfilter (PDF):  $SCRIPT_DIR/mdprint-tables.lua
  mermaid-config.json im Quellverzeichnis wird an mmdc übergeben, falls vorhanden.

ABHÄNGIGKEITEN
  pandoc; xelatex (brew install --cask basictex; sudo tlmgr install collection-fontsrecommended);
  xurl (sudo tlmgr install xurl; fehlt in BasicTeX, ohne es werden lange Links nicht umbrochen;
  ist TeX Live älter als der Server: sudo tlmgr --repository
  https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/JAHR/tlnet-final install xurl);
  Schrift DejaVu (brew install --cask font-dejavu); mmdc (npm install -g @mermaid-js/mermaid-cli); für --epub: rsvg-convert (brew install librsvg);
  optional: epubcheck (brew install epubcheck).

BEISPIELE
  mdprint bericht                      PDF aus bericht.md
  mdprint --no-toc --no-footer *.md    alle Dateien, ohne Verzeichnis und Fußzeile
  mdprint --epub --split-level=3 buch  EPUB, neue Datei ab jeder Überschrift dritter Ebene
  mdprint --epub --pdf --author="Max Muster" buch.md
  mdprint --trim=6x9 buch              Druck-PDF für KDP im Format 6 x 9 Zoll -> buch-6x9.pdf
EOF
}

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
LATEX_HEADER="$SCRIPT_DIR/latex-header.tex"
EPUB_CSS="$SCRIPT_DIR/epub.css"

TOC=1
TOC_DEPTH=4
TOC_TITLE=""
# Standard-Fußzeile: aus ~/.config/mdprint/footer (eine Zeile, $YEAR wird durch das Jahr ersetzt), sonst "© <Jahr>"
FOOTER_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/mdprint/footer"
if [ -r "$FOOTER_FILE" ]; then
  FOOTER=$(head -n 1 "$FOOTER_FILE")
  FOOTER="${FOOTER//\$YEAR/$(date +%Y)}"
else
  FOOTER="© $(date +%Y)"
fi
LANG_DOC="de"
TITLE=""
OUTDIR=""
ASSUME_YES=0
WANT_PDF=""
WANT_EPUB=0
AUTHOR=""
COVER=""
SPLIT_LEVEL=""
TRIM=""

# Optionen auswerten
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --pdf) WANT_PDF=1 ;;
    --epub) WANT_EPUB=1 ;;
    --author=*) AUTHOR=${1#*=} ;;
    --author) shift; AUTHOR=${1:-} ;;
    --cover=*) COVER=${1#*=} ;;
    --cover) shift; COVER=${1:-} ;;
    --split-level=*) SPLIT_LEVEL=${1#*=} ;;
    --split-level) shift; SPLIT_LEVEL=${1:-} ;;
    --no-toc) TOC=0 ;;
    --toc) TOC=1 ;;
    --toc-depth=*) TOC_DEPTH=${1#*=} ;;
    --toc-depth) shift; TOC_DEPTH=${1:-} ;;
    --toc-title=*) TOC_TITLE=${1#*=} ;;
    --toc-title) shift; TOC_TITLE=${1:-} ;;
    --footer=*) FOOTER=${1#*=} ;;
    --footer) shift; FOOTER=${1:-} ;;
    --no-footer) FOOTER="" ;;
    --trim=*) TRIM=${1#*=} ;;
    --trim) shift; TRIM=${1:-} ;;
    --lang=*) LANG_DOC=${1#*=} ;;
    --lang) shift; LANG_DOC=${1:-} ;;
    --title=*) TITLE=${1#*=} ;;
    --title) shift; TITLE=${1:-} ;;
    --outdir=*) OUTDIR=${1#*=} ;;
    --outdir) shift; OUTDIR=${1:-} ;;
    -y|--yes) ASSUME_YES=1 ;;
    --) shift; args+=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "Unbekannte Option: $1" >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done
set -- ${args[@]+"${args[@]}"}

# Ohne --epub ist PDF der Standard; mit --epub nur, wenn --pdf ausdrücklich dabei ist.
if [ -z "$WANT_PDF" ]; then
  if [ "$WANT_EPUB" = 1 ]; then WANT_PDF=0; else WANT_PDF=1; fi
fi

if [ -z "$TOC_TITLE" ]; then
  case "$LANG_DOC" in
    de*) TOC_TITLE="Inhalt" ;;
    *) TOC_TITLE="Contents" ;;
  esac
fi

if [ -n "$OUTDIR" ]; then
  mkdir -p "$OUTDIR" || exit 1
  OUTDIR="$(cd "$OUTDIR" && pwd)"
fi

case "$TOC_DEPTH" in
  [1-6]) ;;
  *) echo "Ungültige --toc-depth: $TOC_DEPTH (erlaubt: 1-6)" >&2; exit 2 ;;
esac

if [ -n "$SPLIT_LEVEL" ]; then
  case "$SPLIT_LEVEL" in
    [1-6]) ;;
    *) echo "Ungültige --split-level: $SPLIT_LEVEL (erlaubt: 1-6)" >&2; exit 2 ;;
  esac
fi

# Buchformat: Seitengröße in Zoll, doppelseitig mit Bundsteg (KDP-Mindestwerte: innen 0,375-0,875 in je nach Umfang, außen 0,25 in)
pandoc_geometry=(-V papersize=a4 -V geometry:a4paper -V geometry:margin=2.5cm)
pdf_suffix=""
text_width_in="6.30"   # DIN A4 21 cm minus 2 x 2,5 cm
if [ -n "$TRIM" ]; then
  if ! printf '%s' "$TRIM" | grep -Eq '^[0-9]+(\.[0-9]+)?x[0-9]+(\.[0-9]+)?$'; then
    echo "Ungültiges --trim: $TRIM (erwartet Breite x Höhe in Zoll, z. B. 6x9)" >&2
    exit 2
  fi
  pandoc_geometry=(-V geometry:paperwidth="${TRIM%x*}in" -V geometry:paperheight="${TRIM#*x}in" -V geometry:inner=0.75in -V geometry:outer=0.55in -V geometry:top=0.7in -V geometry:bottom=0.85in -V geometry:footskip=0.4in -V geometry:twoside -V classoption=twoside)
  pdf_suffix="-$TRIM"
  text_width_in=$(awk -v w="${TRIM%x*}" 'BEGIN { printf "%.2f", w - 1.3 }')
  [ "$WANT_PDF" = 0 ] && echo "WARNUNG: --trim wirkt nur auf das PDF; mit --epub allein bleibt es ohne Wirkung." >&2
fi
# Tabellen im PDF: Spaltenbreiten nach Inhalt, linksbündig, kleinere Schrift (mdprint-tables.lua)
if [ -f "$SCRIPT_DIR/mdprint-tables.lua" ]; then
  pandoc_geometry+=(--lua-filter="$SCRIPT_DIR/mdprint-tables.lua" --metadata mdprint-table-chars="$(awk -v w="$text_width_in" 'BEGIN { printf "%d", w * 15 }')")
else
  echo "WARNUNG: $SCRIPT_DIR/mdprint-tables.lua fehlt — Tabellen werden mit gleich breiten Spalten gesetzt." >&2
fi

if [ -n "$COVER" ]; then
  if [ ! -f "$COVER" ]; then
    echo "Cover nicht gefunden: $COVER" >&2
    exit 2
  fi
  COVER="$(cd "$(dirname "$COVER")" && pwd)/$(basename "$COVER")"
  case "$COVER" in
    *.jpg|*.jpeg|*.JPG|*.JPEG|*.png|*.PNG) ;;
    *) echo "WARNUNG: KDP erwartet das Cover als JPEG oder PNG: $COVER" >&2 ;;
  esac
fi

HAVE_RSVG=1
if [ "$WANT_EPUB" = 1 ] && ! command -v rsvg-convert > /dev/null 2>&1; then
  HAVE_RSVG=0
  echo "WARNUNG: rsvg-convert fehlt (brew install librsvg) — SVG-Bilder bleiben im EPUB als SVG; KDP stellt sie nicht auf allen Geräten dar." >&2
fi

TEMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/mdprint.XXXXXX") || exit 1
trap 'rm -rf "$TEMP_ROOT"' EXIT

rc=0

# Eingabedateien bestimmen
files=()
if [ $# -eq 0 ]; then
  shopt -s nullglob
  files=(*.md)
  shopt -u nullglob
  if [ ${#files[@]} -eq 0 ]; then
    echo "Keine .md-Dateien in $(pwd)." >&2
    exit 1
  fi
else
  for name in "$@"; do
    if [ -f "$name" ]; then
      files+=("$name")
    elif [ -f "$name.md" ]; then
      files+=("$name.md")
    else
      echo "Nicht gefunden: $name (auch nicht $name.md)" >&2
      rc=1
    fi
  done
fi

# Rückgabe 0 = überschreiben, 1 = überspringen; 'q' beendet das Skript
OVERWRITE_ALL=0
confirm_overwrite() {
  local answer
  [ "$OVERWRITE_ALL" = 1 ] && return 0
  [ "$ASSUME_YES" = 1 ] && return 0
  if ! { : < /dev/tty; } 2>/dev/null; then
    echo "$1 existiert (kein Terminal für Rückfrage)." >&2
    return 1
  fi
  if ! read -r -p "$1 existiert. Überschreiben? [y/N/a/q] " answer < /dev/tty; then
    echo
    return 1
  fi
  case "$answer" in
    y|Y|j|J) return 0 ;;
    a|A) OVERWRITE_ALL=1; return 0 ;;
    q|Q) echo "Abgebrochen." >&2; exit 130 ;;
    *) return 1 ;;
  esac
}

pandoc_header=()
if [ "$WANT_PDF" = 1 ]; then
  if [ -f "$LATEX_HEADER" ]; then
    pandoc_header=(--include-in-header="$LATEX_HEADER")
  else
    echo "WARNUNG: $LATEX_HEADER fehlt — PDFs werden ohne Header erzeugt." >&2
  fi
fi

pandoc_css=()
if [ "$WANT_EPUB" = 1 ]; then
  if [ -f "$EPUB_CSS" ]; then
    pandoc_css=(--css="$EPUB_CSS")
  else
    echo "WARNUNG: $EPUB_CSS fehlt — EPUB wird mit dem pandoc-Standardstil erzeugt." >&2
  fi
  # Breite Tabellen werden im EPUB zu Karten (mdprint-epub-tables.lua)
  if [ -f "$SCRIPT_DIR/mdprint-epub-tables.lua" ]; then
    pandoc_css+=(--lua-filter="$SCRIPT_DIR/mdprint-epub-tables.lua")
  fi
fi

# Fußzeile: links Text, rechts Seitenzahl (fancyhdr); gilt auch für die Titelseite (plain)
pandoc_footer=()
if [ "$WANT_PDF" = 1 ] && [ -n "$FOOTER" ]; then
  footer_tex=$(printf "%s" "$FOOTER" | sed -e "s/\\\\/\\\\textbackslash{}/g" -e "s/\([&%\$#_{}]\)/\\\\\1/g" -e "s/~/\\\\textasciitilde{}/g" -e "s/\^/\\\\textasciicircum{}/g")
  footer_file="$TEMP_ROOT/footer.tex"
  if [ -n "$TRIM" ]; then
    # Doppelseitig: Seitenzahl außen, Fußzeilentext innen
    printf "%s\n" "\\usepackage{fancyhdr}" "\\pagestyle{fancy}" "\\fancyhf{}" "\\renewcommand{\\headrulewidth}{0pt}" "\\fancyfoot[LO,RE]{\\scriptsize $footer_tex}" "\\fancyfoot[LE,RO]{\\thepage}" "\\fancypagestyle{plain}{\\fancyhf{}\\renewcommand{\\headrulewidth}{0pt}\\fancyfoot[LO,RE]{\\scriptsize $footer_tex}\\fancyfoot[LE,RO]{\\thepage}}" > "$footer_file"
  else
    printf "%s\n" "\\usepackage{fancyhdr}" "\\pagestyle{fancy}" "\\fancyhf{}" "\\renewcommand{\\headrulewidth}{0pt}" "\\fancyfoot[L]{\\small $footer_tex}" "\\fancyfoot[R]{\\thepage}" "\\fancypagestyle{plain}{\\fancyhf{}\\renewcommand{\\headrulewidth}{0pt}\\fancyfoot[L]{\\small $footer_tex}\\fancyfoot[R]{\\thepage}}" > "$footer_file"
  fi
  pandoc_footer=(--include-in-header="$footer_file")
elif [ "$WANT_PDF" = 1 ] && [ -n "$TRIM" ]; then
  # Ohne Fußzeilentext: Seitenzahl trotzdem außen
  footer_file="$TEMP_ROOT/footer.tex"
  printf "%s\n" "\\usepackage{fancyhdr}" "\\pagestyle{fancy}" "\\fancyhf{}" "\\renewcommand{\\headrulewidth}{0pt}" "\\fancyfoot[LE,RO]{\\thepage}" "\\fancypagestyle{plain}{\\fancyhf{}\\renewcommand{\\headrulewidth}{0pt}\\fancyfoot[LE,RO]{\\thepage}}" > "$footer_file"
  pandoc_footer=(--include-in-header="$footer_file")
fi

# Inhaltsverzeichnis (entspricht: pandoc --toc --toc-depth=4 -V toc-title="Inhalt")
pandoc_toc=()
pandoc_epub_toc=()
if [ "$TOC" = 1 ]; then
  pandoc_toc=(--toc --toc-depth="$TOC_DEPTH" -V toc-title="$TOC_TITLE")
  pandoc_epub_toc=(--toc --toc-depth="$TOC_DEPTH" --metadata toc-title="$TOC_TITLE")
fi

# Für das EPUB: SVG-Bildverweise ![..](pfad.svg) in PNG wandeln.
# $1 = Markdown (wird in place geändert), $2 = Quellverzeichnis, $3 = Scratch-Verzeichnis
convert_svgs() {
  local md="$1" src_dir="$2" tmp="$3" svg src png n=0
  grep -o '](<\{0,1\}[^)<>]*\.svg>\{0,1\})' "$md" 2>/dev/null | sed -e 's/^](<\{0,1\}//' -e 's/>\{0,1\})$//' | sort -u > "$tmp/svglist.txt"
  while IFS= read -r svg; do
    [ -n "$svg" ] || continue
    case "$svg" in
      /*) src="$svg" ;;
      *) src="$src_dir/$svg" ;;
    esac
    if [ ! -f "$src" ]; then
      echo "WARNUNG: SVG nicht gefunden: $src" >&2
      continue
    fi
    png="$tmp/svg_$n.png"
    if rsvg-convert -w 1600 -a -b white "$src" -o "$png" 2>/dev/null; then
      perl -pi -e 'BEGIN { $s = shift @ARGV; $t = shift @ARGV } s/\Q$s\E/$t/g' "$svg" "$png" "$md"
    else
      echo "WARNUNG: rsvg-convert fehlgeschlagen für $src" >&2
    fi
    n=$((n + 1))
  done < "$tmp/svglist.txt"
}

i=0
for mdfile in ${files[@]+"${files[@]}"}; do
  i=$((i + 1))
  source_dir=$(dirname "$mdfile")
  filename=$(basename "$mdfile")
  filename=${filename%.md}
  abs_base="$(cd "$source_dir" && pwd)/${filename}"
  [ -n "$OUTDIR" ] && abs_base="$OUTDIR/${filename}"
  doc_title="${TITLE:-$filename}"
  abs_pdf="$abs_base$pdf_suffix.pdf"
  abs_epub="$abs_base.epub"

  do_pdf=0
  do_epub=0
  if [ "$WANT_PDF" = 1 ]; then
    if [ -e "$abs_pdf" ] && ! confirm_overwrite "$abs_pdf"; then
      echo "→ Übersprungen: $abs_pdf"
    else
      do_pdf=1
    fi
  fi
  if [ "$WANT_EPUB" = 1 ]; then
    if [ -e "$abs_epub" ] && ! confirm_overwrite "$abs_epub"; then
      echo "→ Übersprungen: $abs_epub"
    else
      do_epub=1
    fi
  fi
  if [ "$do_pdf" = 0 ] && [ "$do_epub" = 0 ]; then
    continue
  fi

  FILE_TEMP_DIR="$TEMP_ROOT/$i"
  mkdir -p "$FILE_TEMP_DIR"
  temp_md="$FILE_TEMP_DIR/doc.temp.md"

  echo "→ Verarbeite Mermaid-Diagramme und Bilder in $mdfile …"

  # Erst: Wandle HTML img-Tags in Markdown um (mit sed)
  # Pattern: <img src="path" alt="text" .../> -> ![text](path)
  sed -E 's/<img[^>]*src="([^"]*)"[^>]*alt="([^"]*)"[^>]*\/?>/![\2](\1)/g; s/<img[^>]*alt="([^"]*)"[^>]*src="([^"]*)"[^>]*\/?>/![\1](\2)/g' "$mdfile" | \

  # Dann: Extrahiere und rendere Mermaid-Diagramme
  # tmp = absolutes Scratch-Verzeichnis (PNG-Referenzen sind damit unabhängig vom cwd)
  # input_dir = source_dir (für mermaid-config.json-Lookup)
  awk -v input_dir="$source_dir" -v tmp="$FILE_TEMP_DIR" '
    BEGIN { inblock=0; count=0 }
    /^```mermaid/ {
      inblock=1
      diagram=tmp "/diagram_" count ".mmd"
      print "" > diagram
      print ""
      next
    }
    /^```/ && inblock {
      close(diagram)
      png=tmp "/diagram_" count ".png"
      config_path = input_dir "/mermaid-config.json"
      config_flag = ""
      if (system("test -f \"" config_path "\" > /dev/null 2>&1") == 0) {
        config_flag = " -c \"" config_path "\""
      }
      cmd = "mmdc -i \"" diagram "\" -o \"" png "\"" config_flag
      ret = system(cmd " > /dev/null")
      if (ret != 0) {
        print "WARNUNG: mmdc fehlgeschlagen für Diagramm " count " (Exit " ret ")" > "/dev/stderr"
      }
      print "![Mermaid](<" png ">)"
      print ""
      count++
      inblock=0
      next
    }
    inblock {
      print >> diagram
      next
    }
    # <!-- pagebreak --> auf eigener Zeile -> Marker; wird je Format ersetzt
    # Einrückung bleibt erhalten, damit der Marker auch in einem YAML-Block (include-before: |) gültig bleibt
    /^[[:space:]]*<!-- pagebreak -->[[:space:]]*$/ {
      indent = $0
      sub(/<!-- pagebreak -->.*$/, "", indent)
      print ""
      print indent "MDPRINT_PAGEBREAK"
      print ""
      next
    }
    # Gebe alle Zeilen aus (Mermaid wurde schon verarbeitet)
    {
      print
    }
  ' > "$temp_md"

  if [ "$do_pdf" = 1 ]; then
    temp_pdf_md="$FILE_TEMP_DIR/doc.pdf.md"
    sed 's/^\([[:space:]]*\)MDPRINT_PAGEBREAK$/\1\\newpage/' "$temp_md" > "$temp_pdf_md"
    echo "→ Erzeuge PDF für $filename"
    # Führe pandoc vom source_dir aus aus, damit relative Bildpfade in der MD funktionieren.
    pandoc_log="$FILE_TEMP_DIR/pandoc.log"
    if (cd "$source_dir" && pandoc "$temp_pdf_md" -o "$abs_pdf" --from markdown+hard_line_breaks --pdf-engine=xelatex -V lang="$LANG_DOC" -V colorlinks=true ${pandoc_geometry[@]+"${pandoc_geometry[@]}"} -V fontsize=11pt -V mainfont="DejaVu Serif" -V sansfont="DejaVu Sans" -V monofont="DejaVu Sans Mono" ${pandoc_header[@]+"${pandoc_header[@]}"} ${pandoc_toc[@]+"${pandoc_toc[@]}"} ${pandoc_footer[@]+"${pandoc_footer[@]}"} --metadata title="$doc_title" --standalone 2> "$pandoc_log"); then
      grep -v "Missing character" "$pandoc_log" >&2
      echo "✓ $abs_pdf"
      if [ -n "$TRIM" ] && command -v pdfinfo > /dev/null 2>&1; then
        pages=$(pdfinfo "$abs_pdf" 2>/dev/null | awk '/^Pages:/ { print $2 }')
        if [ -n "$pages" ]; then
          # KDP druckt nur gerade Seitenzahlen; Rücken je Seite: weiß 0,002252 in, creme 0,0025 in
          awk -v p="$pages" 'BEGIN { q = p + p % 2; printf "  Seiten: %d (KDP rechnet mit %d). Rücken für den Umschlag: weißes Papier %.2f mm, creme %.2f mm.\n", p, q, q * 0.002252 * 25.4, q * 0.0025 * 25.4; if (q > 700) print "  WARNUNG: über 700 Seiten braucht KDP mehr als 0,75 in Bundsteg." }'
        fi
      fi
    else
      grep -v "Missing character" "$pandoc_log" >&2
      echo "FEHLER: pandoc fehlgeschlagen für $mdfile" >&2
      rc=1
    fi
  fi

  if [ "$do_epub" = 1 ]; then
    temp_epub_md="$FILE_TEMP_DIR/doc.epub.md"
    # pandoc ignoriert include-before im EPUB. Ein Block "include-before: |" im YAML-Kopf
    # wird deshalb herausgelöst und als Text direkt hinter den YAML-Kopf gestellt.
    sed 's/^\([[:space:]]*\)MDPRINT_PAGEBREAK$/\1<div class="pagebreak"><\/div>/' "$temp_md" | awk '
      BEGIN { inyaml = 0; inib = 0; n = 0 }
      NR == 1 && /^---[[:space:]]*$/ { inyaml = 1; print; next }
      inyaml && /^(---|\.\.\.)[[:space:]]*$/ {
        inyaml = 0; inib = 0
        print
        if (n > 0) { print ""; for (k = 1; k <= n; k++) print buf[k]; print "" }
        next
      }
      inyaml && /^include-before:[[:space:]]*\|/ { inib = 1; next }
      inyaml && inib {
        if ($0 ~ /^[[:space:]]*$/ || $0 ~ /^  /) { line = $0; sub(/^  /, "", line); buf[++n] = line; next }
        inib = 0
      }
      { print }
    ' > "$temp_epub_md"
    if [ "$HAVE_RSVG" = 1 ]; then
      convert_svgs "$temp_epub_md" "$(cd "$source_dir" && pwd)" "$FILE_TEMP_DIR"
    fi

    # Überschriften so verschieben, dass die kleinste vorkommende Ebene zu Ebene 1 wird.
    # Sonst stellt pandoc dem Text ein leeres Kapitel mit dem Buchtitel voran.
    min_level=$(grep -o '^#\{1,6\} ' "$temp_epub_md" | awk '{ n = length($1); if (min == "" || n < min) min = n } END { print (min == "" ? 1 : min) }')
    shift_by=$((min_level - 1))
    epub_shift=()
    if [ "$shift_by" -gt 0 ]; then
      epub_shift=(--shift-heading-level-by="-$shift_by")
    fi
    # Aufteilung: --split-level bezieht sich auf die Ebenen in der Datei; Standard ist die kleinste Ebene
    split="${SPLIT_LEVEL:-$min_level}"
    split=$((split - shift_by))
    [ "$split" -lt 1 ] && split=1

    epub_meta=(--metadata title="$doc_title" --metadata lang="$LANG_DOC")
    if [ -n "$AUTHOR" ]; then
      epub_meta+=(--metadata author="$AUTHOR")
    elif ! grep -q '^author:' "$temp_epub_md"; then
      echo "WARNUNG: kein Autor (weder --author noch author: im YAML-Block) — KDP verlangt einen." >&2
    fi
    epub_cover=()
    if [ -n "$COVER" ]; then
      epub_cover=(--epub-cover-image="$COVER")
    fi
    # dc:date muss ein ISO-Datum sein; ein date: wie "November 2026" bliebe sonst leer (epubcheck-Fehler).
    # Die Titelseite zeigt weiterhin das date: aus der Datei.
    epub_meta_file="$FILE_TEMP_DIR/epub-metadata.xml"
    printf '%s\n' "<dc:date>$(date +%Y-%m-%d)</dc:date>" > "$epub_meta_file"
    epub_meta+=(--epub-metadata="$epub_meta_file")

    echo "→ Erzeuge EPUB für $filename (Teilung ab Ebene ${SPLIT_LEVEL:-$min_level} der Datei)"
    epub_log="$FILE_TEMP_DIR/pandoc-epub.log"
    if (cd "$source_dir" && pandoc "$temp_epub_md" -o "$abs_epub" --from markdown+hard_line_breaks --to epub3 --standalone --split-level="$split" ${epub_shift[@]+"${epub_shift[@]}"} ${epub_meta[@]+"${epub_meta[@]}"} ${epub_cover[@]+"${epub_cover[@]}"} ${pandoc_css[@]+"${pandoc_css[@]}"} ${pandoc_epub_toc[@]+"${pandoc_epub_toc[@]}"} 2> "$epub_log"); then
      cat "$epub_log" >&2
      echo "✓ $abs_epub"
      if command -v epubcheck > /dev/null 2>&1; then
        echo "→ Prüfe EPUB mit epubcheck …"
        epubcheck "$abs_epub" 2>&1 | grep -E "^(ERROR|FATAL|WARNING)\(|^(Messages|Meldungen):" >&2
      fi
    else
      cat "$epub_log" >&2
      echo "FEHLER: pandoc (EPUB) fehlgeschlagen für $mdfile" >&2
      rc=1
    fi
  fi
done

exit $rc
